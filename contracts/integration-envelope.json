  "schemas": {
    "DeviceSnapshot": {
      "type": "object",
      "required": [
        "device_id",
        "status",
        "last_seen_at"
      ],
      "properties": {
        "device_id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "live",
            "synced",
            "stale",
            "offline",
            "revoked"
          ]
        },
        "attestation_tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_seen_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "delivery_id",
        "device_id",
        "channel",
        "content_class",
        "received_at"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "enum": [
            "message.received",
            "message.sensitive_redacted",
            "device.status_changed",
            "device.revoked"
