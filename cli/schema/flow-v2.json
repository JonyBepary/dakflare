{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dakflare.dev/schema/flow-v2.json",
  "title": "DakFlare Flow IR v2",
  "description": "Canonical flow document, derived by hand from worker/src/lib/flow-ir.ts (the Worker's copy of simulator/flow/src/ir.rs). The validator is the source of truth: this document names the fields it accepts and the bounds it enforces, and `dakflare schema --flow-v2` prints it. Where the two disagree, the validator wins.",
  "type": "object",
  "required": ["schema", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "dakflare.flow/v2",
      "description": "Stamped by the validator; an absent value is accepted on input and written back as this constant."
    },
    "nodes": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 400,
      "items": { "$ref": "#/$defs/edge" }
    },
    "ui_layout": {
      "$ref": "#/$defs/ui_layout",
      "description": "Computed by the Worker on save (rank-v1). Accepted on input only when every node has a legacy position, which then wins over the computed layout."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$",
      "description": "A capture group or set_var name. `sender`, `body` and `received_at` are bound by the trigger and reserved."
    },
    "template": {
      "type": "string",
      "maxLength": 2048,
      "description": "Text with `{{ name }}` references (also `{{ vars.name }}`). Every reference must be bound on every path to the node."
    },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "ui_layout": {
      "type": "object",
      "required": ["algorithm", "positions"],
      "properties": {
        "algorithm": { "const": "rank-v1" },
        "positions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/position" }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "data"],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "trigger",
            "extract",
            "set_var",
            "condition",
            "switch",
            "delay",
            "webhook",
            "send_sms",
            "stop"
          ]
        },
        "data": { "type": "object" },
        "position": { "$ref": "#/$defs/position" }
      },
      "allOf": [
        { "$ref": "#/$defs/node_trigger" },
        { "$ref": "#/$defs/node_extract" },
        { "$ref": "#/$defs/node_set_var" },
        { "$ref": "#/$defs/node_condition" },
        { "$ref": "#/$defs/node_switch" },
        { "$ref": "#/$defs/node_delay" },
        { "$ref": "#/$defs/node_webhook" },
        { "$ref": "#/$defs/node_send_sms" }
      ]
    },
    "node_trigger": {
      "if": { "properties": { "type": { "const": "trigger" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "const": "incoming" },
              "sender": {
                "type": "object",
                "properties": {
                  "mode": { "enum": ["any", "exact", "prefix", "regex"] },
                  "value": { "type": "string" }
                },
                "description": "`value` is required unless mode is `any`."
              },
              "body": {
                "type": "object",
                "properties": {
                  "mode": { "enum": ["any", "keyword", "regex"] },
                  "value": { "type": "string" }
                },
                "description": "`value` is required unless mode is `any`. A `regex` value must pass the RE2 lint."
              }
            }
          }
        }
      }
    },
    "node_extract": {
      "if": { "properties": { "type": { "const": "extract" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["pattern"],
            "properties": {
              "source": { "enum": ["body", "sender"], "default": "body" },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "RE2-compatible. Must declare at least one named group, e.g. `(?<order>[0-9]+)`. `(?P<name>...)` is refused; so is a duplicate group name, within one pattern or across the graph, and a name that is a builtin variable."
              },
              "flags": {
                "enum": ["", "i"],
                "description": "Only the case-insensitive flag is accepted."
              }
            }
          }
        }
      }
    },
    "node_set_var": {
      "if": { "properties": { "type": { "const": "set_var" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "$ref": "#/$defs/variable" },
              "value": { "$ref": "#/$defs/template" }
            }
          }
        }
      }
    },
    "node_condition": {
      "if": { "properties": { "type": { "const": "condition" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["left", "op"],
            "properties": {
              "left": { "$ref": "#/$defs/template" },
              "op": { "enum": ["equals", "not_equals", "contains", "matches", "exists"] },
              "right": {
                "$ref": "#/$defs/template",
                "description": "Required unless op is `exists`. For `matches` it must pass the RE2 lint."
              }
            }
          }
        }
      }
    },
    "node_switch": {
      "if": { "properties": { "type": { "const": "switch" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["value", "cases"],
            "properties": {
              "value": { "$ref": "#/$defs/template" },
              "cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "node_delay": {
      "if": { "properties": { "type": { "const": "delay" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["seconds"],
            "properties": {
              "seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
            }
          }
        }
      }
    },
    "node_webhook": {
      "if": { "properties": { "type": { "const": "webhook" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://",
                "description": "https only, and never a loopback, private, CGNAT or metadata address."
              },
              "body": { "$ref": "#/$defs/template" }
            }
          }
        }
      }
    },
    "node_send_sms": {
      "if": { "properties": { "type": { "const": "send_sms" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["to", "body"],
            "properties": {
              "to": { "type": "string", "maxLength": 32, "minLength": 1 },
              "body": { "type": "string", "maxLength": 4096, "minLength": 1 }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "sourceHandle": {
          "type": "string",
          "description": "Required when the source branches: `true`|`false` for a condition, `case:<index>`|`default` for a switch. Not allowed on any other source."
        },
        "label": { "type": "string" }
      }
    },
    "template_span": {
      "type": "object",
      "description": "One highlighted span of a sample message, as accepted by `synthesize_template_json` in simulator/flow-wasm. UTF-16 offsets into `sample_body`.",
      "required": ["role", "start", "end"],
      "properties": {
        "role": { "enum": ["trigger", "extract", "ignore"] },
        "name": { "type": "string" },
        "slot_type": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "optional": { "type": "boolean" }
      }
    },
    "authority_target": {
      "type": "object",
      "description": "The object a `ag1_` apply handle carries, base64url-encoded after `ag1_`. It names exactly what the grant covers, with a fixed key order (worker/src/lib/authority.ts canonicalTargetJson). An empty target matches only an unscoped request, never everything.",
      "additionalProperties": false,
      "properties": {
        "recipients": {
          "type": "array",
          "items": { "type": "string" },
          "description": "E.164 numbers a send may reach. Sorted and de-duplicated when serialised."
        },
        "device_id": { "type": "string" },
        "flow_id": { "type": "string" },
        "rule_id": { "type": "string" },
        "body_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the canonical diff summary, so a handle cannot be replayed against a different patch."
        },
        "max_uses": {
          "type": "integer",
          "minimum": 1,
          "description": "A synthesised handle mints 1: it is for one apply."
        }
      }
    }
  }
}
