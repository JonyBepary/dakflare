<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Inbound SMS. The receiver is manifest-declared so it runs with no Activity. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Outbound flow replies from SmsReceiver; requested with RECEIVE_SMS. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!--
        Own-number sources for the self-number guard (M5.4 requests it at
        runtime). Declared now so the guard can read them once granted; without
        it every source is empty and the guard reports itself as unknown.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <!--
        The subscription list (SIM slot and carrier) is gated on READ_PHONE_STATE,
        not on READ_PHONE_NUMBERS. It is a normal permission, granted at install,
        so the Device frame can stop saying "not reported".
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.simulator"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Only the system (which holds BROADCAST_SMS) can deliver SMS_RECEIVED
            to this receiver. It runs without the Tauri runtime; persistence goes
            through NativeBridge into libsimulator_lib.so.
        -->
        <receiver
            android:name="dev.dakflare.simulator.bridge.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
            Finishes a composed send. `PendingIntent.getBroadcast` targets this
            component with the SENT action, so the broadcast is explicit and the
            receiver stays unexported; no other app can mark a row.
        -->
        <receiver
            android:name="dev.dakflare.simulator.bridge.SendStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.dakflare.simulator.SMS_SENT" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
