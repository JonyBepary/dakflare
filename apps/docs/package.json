{
  "name": "@dakflare/docs",
  "version": "6.3.0-alpha.2",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "next build --webpack",
    "postinstall": "fumadocs-mdx",
    "predev": "node scripts/sync-markdown.mjs",
    "prebuild": "node scripts/sync-markdown.mjs",
    "check:md": "node scripts/sync-markdown.mjs --check",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "npm run build:worker && wrangler deploy",
    "preview": "npm run build:worker && wrangler dev"
  },
  "dependencies": {
    "fumadocs-core": "^16.19.4",
    "fumadocs-mdx": "^15.6.3",
    "fumadocs-openapi": "^12.6.5",
    "fumadocs-ui": "^16.19.4",
    "lucide-react": "^0.487.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.165.0"
  }
}
