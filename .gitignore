# Test identity — contains a P-256 private key. Never commit.
.harness-state*.json

# Local Wrangler state (D1 SQLite, DO SQLite, KV simulation)
.wrangler/
worker/.wrangler/

# Database exports (docs/OPS_BACKUP.md). They contain personal data.
*.sql
# ...but migrations are source, and a new one must never be silently ignored.
!worker/migrations/*.sql

# Local secrets
.dev.vars
worker/.dev.vars
.env
.env.*
!.env.example

# Dependencies
node_modules/

# OS noise
.DS_Store

# Generated test fixture (RSA private key) — never commit
stub-service-account.json

# cf build output (types + bundled assets)
.cloudflare/
worker/.cloudflare/

# Built dashboard (generated by `npm run build` in dashboard/)
worker/public/admin/

# Agent skill installs (tooling, not product)
/.adal/
/.agents/
/.claude/
/agent/

# Landing hero preview page (regenerated by design/landing/build-hero.mjs)
design/landing/hero.html
