[Unit]
Description=Daily check for a verified DakFlare update

[Timer]
# Check only. Nothing is deployed without `edgepay dakflare worker update`.
# The EdgePay CLI rewrites this OnCalendar for weekly/monthly/off.
OnCalendar=*-*-* 09:00:00
Persistent=true
Unit=dakflare-edgepay-check.service

[Install]
WantedBy=timers.target
