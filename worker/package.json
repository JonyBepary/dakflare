{
	"name": "dakflare-worker",
	"version": "6.3.0-alpha.5",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"description": "DakFlare v5 edge backend — Worker + D1 + per-device Durable Object. Implements PROTOCOL_CONTRACT_V5 Rev C.",
	"scripts": {
		"dev": "wrangler dev --local",
		"dev:account": "wrangler dev --config wrangler.account.toml --env-file .dev.vars",
		"build:dashboard": "node scripts/build-dashboard.mjs",
		"deploy": "npm run build:dashboard && node scripts/assert-clean-dashboard.mjs && cf deploy",
		"deploy:no-dashboard": "node scripts/assert-clean-dashboard.mjs && cf deploy",
		"smoke": "./scripts/smoke.sh",
		"cf:check": "cf deploy --dry-run",
		"verify:deploy": "node scripts/verify-deploy.mjs",
		"dev:dashboard": "npm --prefix ../dashboard run dev",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check:config": "node scripts/check-config.mjs",
		"migrate:local": "wrangler d1 migrations apply sms_gateway --local",
		"migrate:preview": "wrangler d1 migrations apply sms_gateway_preview --remote",
		"deploy:worker": "node scripts/assert-clean-dashboard.mjs && cf deploy"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.2",
		"@cloudflare/workers-types": "^5.20261006.1",
		"cf": "^1.0.0-beta.19",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1",
		"wrangler": "^4.112.0"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.14",
		"@earendil-works/chord": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-durable": "1.5.2",
		"@earendil-works/pi-schema": "1.5.2",
		"@modelcontextprotocol/server": "2.4.0",
		"agents": "0.33.0",
		"better-auth": "1.7.14",
		"zod": "4.6.7"
	}
}
