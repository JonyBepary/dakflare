# Copy to `.dev.vars` (git-ignored) for `wrangler dev`.
#
# ADMIN_TOKEN is deliberately NOT in wrangler.toml [vars]: a token in the config
# file is a committed secret. When ADMIN_TOKEN is unset every admin route fails
# closed with 401, so `wrangler dev` alone is not enough — you need this file.
ADMIN_TOKEN="dev-admin-token"

# FCM HTTP v1 service account. Absent is fine locally: the wake push degrades to
# a single log line and command enqueue still works.
# FCM_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","project_id":"..."}'

# ---------------------------------------------------------------------------
# Timing overrides (optional). All are Number-parsed and clamped; the defaults
# are LEASE_MS=60000, ACK_TIMEOUT_MS=8000, OFFLINE_ALERT_MS=900000,
# STALE_SOCKET_MS=120000, NONCE_WINDOW_MS=300000. The conformance suite shrinks
# these so it does not have to wait a minute for a lease to expire or 15 min for
# an offline alert.
#
# LEASE_MS is NOT the ack timeout. It is how long one device may hold a command
# exclusively; the ack timeout only closes a socket that has gone quiet. A lease
# shorter than a real send duplicates SMS, so leave it at 60 s in production.
# ---------------------------------------------------------------------------
# LEASE_MS="1500"
# ACK_TIMEOUT_MS="500"
# OFFLINE_ALERT_MS="5000"
# STALE_SOCKET_MS="2000"
# NONCE_WINDOW_MS="300000"

# ---------------------------------------------------------------------------
# Auth (docs/AUTH_PLAN.md). `AUTH_MODE` is retired: one gate, two credentials
# (a Better Auth session, or ADMIN_TOKEN plus `X-Dakflare-Client: cli`).
#
# BETTER_AUTH_SECRET signs session cookies and encrypts TOTP secrets. Generate
# one with: openssl rand -base64 32
# Absent => /api/auth and /v1/auth/* answer 503; admin routes are unaffected.
# BETTER_AUTH_SECRET=""
#
# The Worker's own origin. Used for trustedOrigins, the WebAuthn rpId (its
# hostname) and the Secure-cookie decision (https => secure). Local dev MUST be
# http here or the browser refuses the __Secure- session cookie.
AUTH_BASE_URL="http://127.0.0.1:8787"
# Comma-separated extra origins allowed to call /api/auth (the console's origin).
AUTH_TRUSTED_ORIGINS="http://127.0.0.1:8787"
# Pin the WebAuthn rpId. Defaults to AUTH_BASE_URL's hostname; production pins
# sohelahmedjony.workers.dev (AUTH_PLAN §3). Changing it invalidates passkeys.
# AUTH_RP_ID="sohelahmedjony.workers.dev"
